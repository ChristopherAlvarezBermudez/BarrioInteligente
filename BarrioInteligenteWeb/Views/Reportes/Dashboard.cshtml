@using BarrioInteligenteWeb.Models
@{
    Layout = null;
    ViewData["Title"] = "Dashboard de Inteligencia Urbana";
    var topCiudadanos = ViewBag.TopCiudadanos as List<Usuario> ?? new List<Usuario>();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] — Barrio Inteligente</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/barrio.css" asp-append-version="true" />
</head>
<body>
    <div class="app-screen">
        @{
            ViewData["ActiveTab"] = "Dashboard";
        }
        @await Html.PartialAsync("_AppHeader")

        <div class="page-container">
            <div class="container-fluid p-0">
                <div class="row mb-4">
                    <div class="col-12">
                        <h4 class="fw-bold text-dark mb-1">Panel de Control Urbano</h4>
                        <p class="text-muted mb-0">Análisis y estadísticas en tiempo real de los reportes de la comunidad</p>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- Gráfico Categorías -->
                    <div class="col-12 col-lg-6">
                        <div class="card shadow-sm h-100 border-0 rounded-4">
                            <div class="card-body p-4">
                                <h5 class="card-title fw-bold text-secondary mb-4">Reportes por Categoría</h5>
                                <div class="position-relative" style="height: 300px;">
                                    <canvas id="chartCategorias"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Gráfico Estados -->
                    <div class="col-12 col-lg-6">
                        <div class="card shadow-sm h-100 border-0 rounded-4">
                            <div class="card-body p-4">
                                <h5 class="card-title fw-bold text-secondary mb-4">Estado de los Reportes</h5>
                                <div class="position-relative" style="height: 300px;">
                                    <canvas id="chartEstados"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Top Ciudadanos -->
                    <div class="col-12">
                        <div class="card shadow-sm border-0 rounded-4">
                            <div class="card-header bg-white border-0 pt-4 pb-2 px-4">
                                <h5 class="card-title fw-bold text-secondary m-0">🏆 Ciudadanos Destacados</h5>
                            </div>
                            <div class="card-body px-4 pb-4">
                                <div class="row g-3">
                                    @foreach (var usuario in topCiudadanos)
                                    {
                                        var badgeColor = usuario.Reputacion switch {
                                            NivelReputacion.Excelente => "bg-success",
                                            NivelReputacion.Buena => "bg-primary",
                                            NivelReputacion.Regular => "bg-warning",
                                            NivelReputacion.Mala => "bg-danger",
                                            NivelReputacion.Critica => "bg-dark",
                                            _ => "bg-secondary"
                                        };

                                        <div class="col-12 col-md-4">
                                            <div class="p-3 border rounded-3 d-flex align-items-center bg-light-subtle">
                                                <div class="me-3 position-relative flex-shrink-0">
                                                    @if (!string.IsNullOrEmpty(usuario.FotoPerfil))
                                                    {
                                                        <img src="@usuario.FotoPerfil" alt="@usuario.NombreCompleto" class="rounded-circle border border-2 border-white shadow-sm" style="width: 48px; height: 48px; object-fit: cover;">
                                                    }
                                                    else
                                                    {
                                                        <div class="rounded-circle shadow-sm d-flex align-items-center justify-content-center text-white fw-bold @badgeColor" style="width: 48px; height: 48px; font-size: 1.1rem;">
                                                            @usuario.NombreCompleto.Substring(0, 1).ToUpper()
                                                        </div>
                                                    }
                                                    <span class="position-absolute bottom-0 start-100 translate-middle p-1 bg-white border border-light rounded-circle" title="@usuario.Reputacion">
                                                        <span class="badge @badgeColor rounded-circle p-1" style="width: 13px; height: 13px; display: inline-block;"></span>
                                                    </span>
                                                </div>
                                                <div class="overflow-hidden">
                                                    <h6 class="mb-1 fw-bold text-dark text-truncate">@usuario.NombreCompleto</h6>
                                                    <small class="text-muted d-block fw-medium">@usuario.PuntosReputacion pts • @usuario.Reputacion</small>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    @if (!topCiudadanos.Any())
                                    {
                                        <div class="col-12">
                                            <p class="text-muted mb-0">No hay ciudadanos destacados aún.</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @await Html.PartialAsync("_BottomNav")
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Datos desde ViewBag
            const dataCategorias = @Html.Raw(ViewBag.DataCategorias ?? "[]");
            const dataEstados = @Html.Raw(ViewBag.DataEstados ?? "[]");

            // Configurar Gráfico Categorías (Doughnut)
            const ctxCat = document.getElementById('chartCategorias').getContext('2d');
            new Chart(ctxCat, {
                type: 'doughnut',
                data: {
                    labels: dataCategorias.map(d => d.Categoria || d.categoria),
                    datasets: [{
                        data: dataCategorias.map(d => d.Count || d.count),
                        backgroundColor: ['#10B981', '#3B82F6', '#F59E0B', '#EF4444', '#8B5CF6'],
                        borderWidth: 0,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { 
                            position: 'bottom',
                            labels: {
                                font: { family: "'Inter', sans-serif", size: 13 },
                                usePointStyle: true,
                                padding: 20
                            }
                        }
                    },
                    cutout: '70%',
                    layout: { padding: 10 }
                }
            });

            // Configurar Gráfico Estados (Bar)
            const ctxEst = document.getElementById('chartEstados').getContext('2d');
            new Chart(ctxEst, {
                type: 'bar',
                data: {
                    labels: dataEstados.map(d => d.Estado || d.estado),
                    datasets: [{
                        label: 'Reportes Activos',
                        data: dataEstados.map(d => d.Count || d.count),
                        backgroundColor: ['#6366F1', '#EC4899', '#14B8A6'],
                        borderRadius: 6,
                        barThickness: 'flex',
                        maxBarThickness: 45
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { precision: 0, font: { family: "'Inter', sans-serif" } },
                            grid: { borderDash: [5, 5], color: '#e5e7eb' },
                            border: { display: false }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { family: "'Inter', sans-serif", weight: '500' } },
                            border: { display: false }
                        }
                    },
                    layout: { padding: { top: 10, bottom: 10 } }
                }
            });
        });
    </script>
</body>
</html>
